{
  "manifest_version": 3,
  "name": "Super AD Blocker",
  "version": "3.2.0",
  "description": "Strong ad/tracker blocker: ~24,000+ EasyList/EasyPrivacy/HaGeZi-derived rules plus a curated cookie-consent/chum-box/push-spam annoyance list, cosmetic filtering, anti-adblock-detection bypass, YouTube ad stripping at the source, a curated performance list that blocks heavy chat-widget/session-recorder scripts, a curated cross-site tracking pixel blocklist plus tracking-parameter stripping, and a curated allowlist to protect legitimate services.",
  "homepage_url": "https://github.com/arunkumarjust97-arch/Super-Blocker",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      },
      {
        "id": "ruleset_2",
        "enabled": true,
        "path": "easylist-rules.json"
      },
      {
        "id": "ruleset_3",
        "enabled": true,
        "path": "hagezi-rules.json"
      },
      {
        "id": "ruleset_4",
        "enabled": true,
        "path": "allowlist-rules.json"
      },
      {
        "id": "ruleset_5",
        "enabled": true,
        "path": "annoyance-rules.json"
      },
      {
        "id": "ruleset_6",
        "enabled": true,
        "path": "performance-rules.json"
      },
      {
        "id": "ruleset_7",
        "enabled": true,
        "path": "tracker-rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "push-block.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "antiadblock.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*",
        "*://*.youtubekids.com/*"
      ],
      "js": [
        "youtube-strip-ads.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "youtube-adskip.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "generic-video-adskip.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "focus-mode.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "browse-faster.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "anti-tracking.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "sponsored.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}